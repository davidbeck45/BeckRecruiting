# Server
PORT=3000
# Public base URL used in tracking links embedded in emails
PUBLIC_BASE_URL=http://localhost:3000

# SQLite database file
DATABASE_PATH=./data/beckrecruiting.db

# CollegeFootballData.com API key (free: https://collegefootballdata.com/key)
CFBD_API_KEY=

# Anthropic API key for AI email composition + school matching.
# If unset, the composer falls back to a plain template so dev still works.
ANTHROPIC_API_KEY=

# Email provider: "console" (dev, logs to stdout) or "resend"
EMAIL_PROVIDER=console
RESEND_API_KEY=
# From address must be on a verified sending domain in production
EMAIL_FROM=Beck Recruiting <outreach@mail.beckrecruiting.com>
